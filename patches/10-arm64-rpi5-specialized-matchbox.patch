+		--build-arg INITRAMFS_ASSET=$(ASSET_PREFIX)initramfs-metal-arm64.xz \
+		$(call image-tags,matchbox,$(TALOS_VERSION)$(BOARD_SUFFIX)) \
+		$(call cache-args,matchbox$(BOARD_SUFFIX)) \
+		--metadata-file images/matchbox$(BOARD_SUFFIX).json \
 		$(BUILDX_ARGS)
