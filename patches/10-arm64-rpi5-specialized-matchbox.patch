 	mkdir -p ../../../_out/assets
 	cat images/talos/profiles/$(subst build-talos-,,$@).yaml | \
 		docker run --rm -i -v /dev:/dev --privileged "ghcr.io/siderolabs/imager:$(TALOS_VERSION)" --tar-to-stdout - | \
 		tar -C ../../../_out/assets -xzf-
-
diff --git a/packages/core/talos/hack/gen-profiles.sh b/packages/core/talos/hack/gen-profiles.sh
old mode 100755
new mode 100644
index 2a273c2..7e61c0f
--- a/packages/core/talos/hack/gen-profiles.sh
+++ b/packages/core/talos/hack/gen-profiles.sh
@@ -3,7 +3,7 @@ set -e
 set -u
 
 TMPDIR=$(mktemp -d)
-PROFILES="initramfs kernel iso installer nocloud metal"
+PROFILES="initramfs kernel iso installer installer-rpi5 initramfs-rpi5 kernel-rpi5 nocloud metal metal-rpi5"
 FIRMWARES="amd-ucode amdgpu bnx2-bnx2x i915 intel-ice-firmware intel-ucode qlogic-firmware"
 EXTENSIONS="drbd zfs spin hailort vc4"
 
@@ -42,7 +42,34 @@ done
 for profile in $PROFILES; do
   echo "writing profile images/talos/profiles/$profile.yaml"
   board=""
+  overlay_block=""
   case "$profile" in
+    initramfs-rpi5)
+      image_options="{}"
+      out_format="raw"
+      platform="metal"
+      kind="initramfs"
+      board="rpi_generic"
+      overlay_block=$(cat <<EOF
+  overlay:
+    imageRef: ghcr.io/siderolabs/sbc-raspberrypi:v0.1.8
+    name: rpi_5
+EOF
+)
+      ;;
+    kernel-rpi5)
+      image_options="{}"
+      out_format="raw"
+      platform="metal"
+      kind="kernel"
+      board="rpi_generic"
+      overlay_block=$(cat <<EOF
+  overlay:
+    imageRef: ghcr.io/siderolabs/sbc-raspberrypi:v0.1.8
+    name: rpi_5
+EOF
+)
+      ;;
     initramfs|kernel|iso)
       image_options="{}"
       out_format="raw"
@@ -55,6 +82,19 @@ for profile in $PROFILES; do
       platform="metal"
       kind="installer"
       ;;
+    installer-rpi5)
+      image_options="{}"
+      out_format="raw"
+      platform="metal"
+      kind="installer"
+      board="rpi_generic"
+      overlay_block=$(cat <<EOF
+  overlay:
+    imageRef: ghcr.io/siderolabs/sbc-raspberrypi:v0.1.8
+    name: rpi_5
+EOF
+)
+      ;;
     metal)
       image_options="{ diskSize: 1306525696, diskFormat: raw }"
       out_format=".xz"
@@ -62,6 +102,19 @@ for profile in $PROFILES; do
       kind="image"
       board="rpi_generic"
       ;;
+    metal-rpi5)
+      image_options="{ diskSize: 1306525696, diskFormat: raw }"
+      out_format=".xz"
+      platform="metal"
+      kind="image"
+      board="rpi_generic"
+      overlay_block=$(cat <<EOF
+  overlay:
+    imageRef: ghcr.io/siderolabs/sbc-raspberrypi:v0.1.8
+    name: rpi_5
+EOF
+)
+      ;;
     nocloud)
       image_options="{ diskSize: 1306525696, diskFormat: raw }"
       out_format=".xz"
@@ -89,6 +142,7 @@ input:
     path: /usr/install/arm64/initramfs.xz
   baseInstaller:
     imageRef: "ghcr.io/siderolabs/installer:${TALOS_VERSION}"
+${overlay_block}
   systemExtensions:
     - imageRef: ${AMD_UCODE_IMAGE}
     - imageRef: ${AMDGPU_IMAGE}
