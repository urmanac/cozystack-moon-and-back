diff --git a/hailort/pkg.yaml b/hailort/pkg.yaml
index 53fb4b9..4ed745b 100644
--- a/hailort/pkg.yaml
+++ b/hailort/pkg.yaml
@@ -12,8 +12,8 @@ steps:
         sha256: "{{ .hailort_sha256 }}"
         sha512: "{{ .hailort_sha512 }}"
 
-      - url: https://hailo-hailort.s3.eu-west-2.amazonaws.com/Hailo8/{{ .hailort_version }}/FW/hailo8_fw.{{ .hailort_version }}.bin
-        destination: hailo8_fw.bin
+      - url: https://hailo-hailort.s3.eu-west-2.amazonaws.com/Hailo10H/{{ .hailort_version }}/FW/hailo10h_fw.tar.gz
+        destination: hailo10h_fw.tar.gz
         sha256: "{{ .hailort_fw_sha256 }}"
         sha512: "{{ .hailort_fw_sha512 }}"
     env:
@@ -23,17 +23,29 @@ steps:
       - |
         tar xf hailort-driver.tar.gz --strip-components=1
       - |
-        mkdir -p /rootfs/usr/lib/modules/$(cat /src/include/config/kernel.release)/ /rootfs/usr/lib/firmware/hailo/ /rootfs/usr/lib/udev/rules.d/
+        # Fix for newer kernels where del_timer_sync was renamed to timer_delete_sync
+        find . -name "*.c" -o -name "*.h" | xargs sed -i 's/del_timer_sync/timer_delete_sync/g'
+      - |
+        mkdir -p /rootfs/usr/lib/modules/$(cat /src/include/config/kernel.release)/ /rootfs/usr/lib/firmware/hailo/hailo10h/ /rootfs/usr/lib/udev/rules.d/
     build:
       - |
         cd linux/pcie
         make -j $(nproc) KERNEL_DIR=/src/ all
     install:
       - |
-        mv hailo8_fw.bin /rootfs/usr/lib/firmware/hailo/hailo8_fw.bin
+        tar xf hailo10h_fw.tar.gz -C /rootfs/usr/lib/firmware/hailo/hailo10h/
+      - |
+        # Dereference any symlinks in the firmware dir. The Talos imager's moveFiles
+        # processes firmware files alphabetically via os.Stat (which follows symlinks).
+        # If a symlink target (e.g. u-boot-0.dtb.signed) is moved before the symlink
+        # itself (u-boot-default.dtb.signed), os.Stat fails with ENOENT. Replacing
+        # symlinks with real files avoids this race condition entirely.
+        for f in /rootfs/usr/lib/firmware/hailo/hailo10h/*; do
+          [ -L "$f" ] && target=$(readlink -f "$f") && cp "$target" "${f}.tmp" && rm "$f" && mv "${f}.tmp" "$f"
+        done
+      - |
         cd linux/pcie
         make -j $(nproc) -C /src M=$(pwd) modules_install INSTALL_MOD_PATH=/rootfs/usr INSTALL_MOD_DIR=kernel/drivers/misc INSTALL_MOD_STRIP=1
-        cp 51-hailo-udev.rules /rootfs/usr/lib/udev/rules.d/51-hailo-udev.rules
     test:
       - |
         # https://www.kernel.org/doc/html/v4.15/admin-guide/module-signing.html#signed-modules-and-stripping
