diff --git a/packages/core/talos/hack/gen-profiles.sh b/packages/core/talos/hack/gen-profiles.sh
index bbe932d..af333cc 100755
--- a/packages/core/talos/hack/gen-profiles.sh
+++ b/packages/core/talos/hack/gen-profiles.sh
@@ -5,7 +5,7 @@ set -u
 TMPDIR=$(mktemp -d)
 PROFILES="initramfs kernel iso installer nocloud metal"
 FIRMWARES="amd-ucode amdgpu bnx2-bnx2x i915 intel-ice-firmware intel-ucode qlogic-firmware"
-EXTENSIONS="drbd zfs"
+EXTENSIONS="drbd zfs spin hailort vc4"
 
 mkdir -p images/talos/profiles
 
@@ -28,13 +28,20 @@ done
 for extension in $EXTENSIONS; do
   printf "fetching %s version: " "$extension"
   extension_var=$(echo "$extension" | tr '[:lower:]' '[:upper:]' | tr - _)_IMAGE
-  image=$(grep -F "/$extension:" $TMPDIR/image-digests)
+  # Allow override from environment
+  eval "existing_image=\${$extension_var:-}"
+  if [ -n "$existing_image" ]; then
+    image="$existing_image"
+  else
+    image=$(grep -F "/$extension:" $TMPDIR/image-digests)
+  fi
   echo "$image"
   export "$extension_var=$image"
 done
 
 for profile in $PROFILES; do
   echo "writing profile images/talos/profiles/$profile.yaml"
+  board=""
   case "$profile" in
     initramfs|kernel|iso)
       image_options="{}"
@@ -53,6 +60,7 @@ for profile in $PROFILES; do
       out_format=".xz"
       platform="metal"
       kind="image"
+      board="rpi_generic"
       ;;
     nocloud)
       image_options="{ diskSize: 1306525696, diskFormat: raw }"
@@ -69,15 +77,16 @@ for profile in $PROFILES; do
   cat > images/talos/profiles/$profile.yaml <<EOT
 # this file generated by hack/gen-profiles.sh
 # do not edit it
-arch: amd64
+arch: arm64
 platform: ${platform}
+board: ${board}
 secureboot: false
 version: ${TALOS_VERSION}
 input:
   kernel:
-    path: /usr/install/amd64/vmlinuz
+    path: /usr/install/arm64/vmlinuz
   initramfs:
-    path: /usr/install/amd64/initramfs.xz
+    path: /usr/install/arm64/initramfs.xz
   baseInstaller:
-    imageRef: "ghcr.io/siderolabs/installer:${TALOS_VERSION}"
+    imageRef: "${INSTALLER_IMAGE:-ghcr.io/siderolabs/installer:${TALOS_VERSION}}"
   systemExtensions:
@@ -90,6 +99,9 @@ input:
     - imageRef: ${QLOGIC_FIRMWARE_IMAGE}
     - imageRef: ${DRBD_IMAGE}
     - imageRef: ${ZFS_IMAGE}
+    - imageRef: ${SPIN_IMAGE}
+    - imageRef: ${HAILORT_IMAGE}
+    - imageRef: ${VC4_IMAGE}
 output:
   kind: ${kind}
   imageOptions: ${image_options}
diff --git a/packages/core/talos/hack/gen-versions.sh b/packages/core/talos/hack/gen-versions.sh
index 143356b..79a6db4 100755
--- a/packages/core/talos/hack/gen-versions.sh
+++ b/packages/core/talos/hack/gen-versions.sh
@@ -1,7 +1,7 @@
 #!/bin/sh
 
 FIRMWARES="amd-ucode amdgpu-firmware bnx2-bnx2x i915-ucode intel-ice-firmware intel-ucode qlogic-firmware"
-EXTENSIONS="drbd zfs"
+EXTENSIONS="drbd zfs spin hailort vc4"
 
 talos_version=${1:-$(skopeo --override-os linux --override-arch amd64 list-tags docker://ghcr.io/siderolabs/imager | jq -r '.Tags[]' | grep '^v[0-9]\+.[0-9]\+.[0-9]\+$' | sort -V | tail -n 1)}
 
